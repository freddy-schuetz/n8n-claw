      "id": "sched-01"
    },
    {
      "parameters": {
        "jsCode": "// Fetch all pending reminders that are due\nconst now = new Date().toISOString();\nconst reminders = await helpers.httpRequest({\n  method: 'GET',\n  url: `{{SUPABASE_URL}}/rest/v1/reminders?reminded_at=is.null&remind_at=lte.${now}&order=remind_at.asc`,\n  headers: {\n    'apikey': '{{SUPABASE_SERVICE_KEY}}',\n    'Content-Type': 'application/json'\n  },\n  json: true\n});\n\nif (!reminders || reminders.length === 0) {\n  return [];\n}\n\n// Zustellweg je Zeile (10.09.2026): Telegram-Nummer -> Telegram-Knoten wie bisher,\n// alles andere (web:..., teams:a:...) -> Zustellung ueber die Teams-Bruecke bzw.\n// den Verlauf, Aufgaben (type task) -> Agent. Vorher gab es nur Telegram.\nreturn reminders.map(r => {\n  const telegram = /^\\d+$/.test(String(r.chat_id || ''));\n  const weg = r.type === 'task' ? 'agent' : (telegram ? 'telegram' : 'zustellung');\n  return { json: Object.assign({}, r, { zustellweg: weg, text: '\\u23F0 ' + (r.message || ''), session_id: telegram ? null : r.chat_id, art: 'erinnerung' }) };\n});"
      },
      "name": "Check Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "check-01"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-reminders",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Has Reminders",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "id": "if-01"
    },
