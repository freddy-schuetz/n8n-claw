        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_AGENT_WORKFLOW_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": false
        },
        "inputData": {
          "mappingMode": "defineBelow",
          "value": {
            "message": "={{ $json.message }}",
            "chat_id": "={{ $json.chat_id }}",
            "user_id": "={{ $json.user_id }}",
            "source": "scheduled_task"
          }
        }
      },
      "name": "Execute Agent",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        896,
        200
      ],
      "id": "exec-agent-01"
    },
    {
      "parameters": {
        "jsCode": "// Faellige Erinnerungen als erledigt markieren, je Zweig (Telegram, Zustellung, Agent).\n// Die Zustellung liefert die Erinnerungs-Id im Datensatz mit, der Agent-Zweig reicht\n// die Zeile durch; der Telegram-Knoten liefert die Telegram-Antwort, dort greift die\n// Paarung zur Eingangszeile (itemMatching). Erst wenn nichts davon eine Id ergibt,\n// werden alle faelligen Zeilen markiert, damit nichts jede Minute wiederholt wird.\n// Schlaegt ein Zweig fehl, endet der Lauf vorher, und seine Zeilen bleiben offen.\nconst ids = new Set();\nconst eing = $input.all();\nfor (let i = 0; i < eing.length; i++) {\n  const j = eing[i].json || {};\n  let id = (j.id !== undefined && j.id !== null && /^\\d+$/.test(String(j.id))) ? j.id : null;\n  if (id === null) { try { id = $('Has Reminders').itemMatching(i).json.id; } catch (_e) { id = null; } }\n  if (id !== null && id !== undefined) ids.add(id);\n}\nif (!ids.size) for (const it of $('Has Reminders').all()) { if (it.json && it.json.id !== undefined) ids.add(it.json.id); }\nconst marked = [];\nfor (const id of ids) {\n  await helpers.httpRequest({\n    method: 'PATCH',\n    url: `{{SUPABASE_URL}}/rest/v1/reminders?id=eq.${id}`,\n    headers: {\n      'apikey': '{{SUPABASE_SERVICE_KEY}}',\n      'Content-Type': 'application/json'\n    },\n    body: { reminded_at: new Date().toISOString() },\n    json: true\n  });\n  marked.push({ json: { id, marked: true } });\n}\nreturn marked;"
      },
      "name": "Mark Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "mark-01"
    },
